<?php

/**
 * @file
 * Install file for multiple_email module
 */

/**
 * Implements hook_install().
 *
 * Imports current users' emails.
 */
function multiple_email_install() {
  db_query("
    INSERT INTO {multiple_email}
      (uid, email, time_registered, confirmed)
    SELECT
      MIN(uid) AS uid,
      mail,
      MIN(created) AS time_registered,
      1
    FROM {users}
    WHERE uid != 0
    AND mail != ''
    GROUP BY mail
  ");

  // Mark schema as installed (no updates defined, so version 0).
  backdrop_set_installed_schema_version('multiple_email', 0);

  // Grant "use multiple emails" to authenticated users by default.
  $rid = defined('BACKDROP_AUTHENTICATED_ROLE') ? BACKDROP_AUTHENTICATED_ROLE : NULL;
  if (!$rid) {
    foreach (user_roles() as $role_id => $role_name) {
      if ($role_name === 'authenticated user') {
        $rid = $role_id;
        break;
      }
    }
  }
  if ($rid) {
    user_role_grant_permissions($rid, array('use multiple emails'));
  }
}

/**
 * Implements hook_uninstall().
 */
function multiple_email_uninstall() {
  // Remove configuration.
  config('multiple_email.settings')->delete();

  // Drop data table if it still exists.
  if (db_table_exists('multiple_email')) {
    db_query('DROP TABLE {multiple_email}');
  }
}

/**
 * Implements hook_enable().
 */
function multiple_email_enable() {
  // Ensure the data table exists when the module is enabled.
  if (!db_table_exists('multiple_email')) {
    try {
      backdrop_install_schema('multiple_email');
    }
    catch (Exception $e) {
      watchdog('multiple_email', 'Failed to create multiple_email table on enable: @msg', array('@msg' => $e->getMessage()), WATCHDOG_ERROR);
    }
  }

  backdrop_set_message(t("Multiple E-mail settings are available under !link", array(
    '!link' => l(t('Configuration') . ' > ' . t('User Accounts') . ' > ' . t('Multiple E-mails'), 'admin/config/people/multiple-email'),
  )));
}

/**
 * Implements hook_schema().
 */
function multiple_email_schema() {
  $schema_version = backdrop_get_installed_schema_version('multiple_email');

  // If the module is not installed yet but the table exists, drop it so
  // installation can recreate it cleanly. Once installed, do not drop to
  // avoid data loss during cache rebuilds or schema inspections.
  if (($schema_version === SCHEMA_UNINSTALLED || $schema_version === NULL) && db_table_exists('multiple_email')) {
    try {
      db_drop_table('multiple_email');
    }
    catch (Exception $e) {
      watchdog('multiple_email', 'Failed to drop existing multiple_email table during install: @msg', array('@msg' => $e->getMessage()), WATCHDOG_WARNING);
      // Attempt a direct SQL drop as a fallback.
      try {
        db_query('DROP TABLE {multiple_email}');
      }
      catch (Exception $e2) {
        watchdog('multiple_email', 'Fallback drop for multiple_email table also failed: @msg', array('@msg' => $e2->getMessage()), WATCHDOG_WARNING);
      }
    }
  }

  $schema['multiple_email'] = array(
    'description' => 'The base table for multiple email.',
    'fields' => array(
      'eid' => array(
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ),
      'uid' => array(
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ),
      'email' => array(
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
      ),
      'time_registered' => array(
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
      ),
      'confirmed' => array(
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ),
      'confirm_code' => array(
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
        'default' => '',
      ),
      'time_code_generated' => array(
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
      ),
      'attempts' => array(
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ),
    ),
    'indexes' => array(
      'uid' => array('uid'),
    ),
    'unique keys' => array(
      'email' => array('email'),
    ),
    'primary key' => array('eid'),
  );

  return $schema;
}

/**
 * Recreate the data table if it is missing.
 */
function multiple_email_update_1000() {
  if (db_table_exists('multiple_email')) {
    return t('multiple_email table already exists.');
  }

  try {
    backdrop_install_schema('multiple_email');
    return t('Recreated missing multiple_email table.');
  }
  catch (Exception $e) {
    watchdog('multiple_email', 'Failed to recreate multiple_email table in update_1000: @msg', array('@msg' => $e->getMessage()), WATCHDOG_ERROR);
    throw $e;
  }
}

/**
 * Grant default permission to authenticated users.
 */
function multiple_email_update_1001() {
  $rid = defined('BACKDROP_AUTHENTICATED_ROLE') ? BACKDROP_AUTHENTICATED_ROLE : NULL;
  if (!$rid) {
    foreach (user_roles() as $role_id => $role_name) {
      if ($role_name === 'authenticated user') {
        $rid = $role_id;
        break;
      }
    }
  }
  if ($rid) {
    user_role_grant_permissions($rid, array('use multiple emails'));
    return t('Granted "use multiple emails" to authenticated users.');
  }

  return t('Could not determine authenticated user role to grant permission.');
}
