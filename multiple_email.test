<?php

/**
 * @file
 * Backdrop tests for the Multiple E-mail module.
 */

class MultipleEmailPermissionsTest extends BackdropWebTestCase {

  protected $owner;
  protected $basic;
  protected $admin;

  public static function getInfo() {
    return array(
      'name' => t('Multiple Email: permissions and flows'),
      'description' => t('Covers add/confirm/delete flows and access control.'),
      'group' => t('Multiple E-mail'),
    );
  }

  public function setUp() {
    parent::setUp('multiple_email');

    $this->owner = $this->backdropCreateUser(array('use multiple emails'));
    $this->basic = $this->backdropCreateUser();
    $this->admin = $this->backdropCreateUser(array('administer users', 'administer multiple emails'));
  }

  public function testOwnerManageFlow() {
    global $user;
    $user = $this->owner;
    $uid = $this->owner->uid;

    // Add a secondary address directly via API.
    $email = $this->randomName() . '@example.com';
    $eid = multiple_email_register_email($uid, $email, FALSE);
    $address = multiple_email_find_address($email);
    $this->assertTrue(!empty($address), 'Secondary address was stored.');
    $this->assertIdentical((int) $address->confirmed, 0, 'Secondary address starts unconfirmed.');

    // Confirm the address.
    multiple_email_confirm_email($address, TRUE);
    $address = multiple_email_find_address($email);
    $this->assertIdentical((int) $address->confirmed, 1, 'Secondary address was confirmed.');

    // Allow editing non-primary addresses and update it.
    config_set('multiple_email.settings', 'multiple_email_edit_emails', 1);
    $new_email = $this->randomName() . '@example.com';
    multiple_email_register_email($uid, $new_email, FALSE, $eid);
    $address = multiple_email_find_address($new_email);
    $this->assertTrue(!empty($address), 'Updated address stored.');

    // Delete the address.
    multiple_email_delete_email($address->eid);
    $this->assertFalse(multiple_email_find_address($new_email), 'Address removed after delete.');
  }

  public function testPermissionDenials() {
    global $user;
    $user = $this->basic;
    $this->assertFalse(_multiple_email_access('pages', $this->basic), 'Basic user cannot access email management.');
  }

  public function testAdminCanManageOthers() {
    global $user;
    $user = $this->admin;
    $account = $this->basic;
    $this->assertTrue(_multiple_email_access('pages', $account), 'Admin can access other user email management.');

    $email = $this->randomName() . '@example.com';
    multiple_email_register_email($account->uid, $email, TRUE);
    $address = multiple_email_find_address($email);
    $this->assertTrue(!empty($address), 'Admin added address for another user.');
  }

  /**
   * Light UI coverage for owner, admin, and basic user.
   */
  public function testUiSmoke() {
    global $user;

    // Owner access check + API add.
    $user = $this->owner;
    $uid = $this->owner->uid;
    $email = $this->randomName() . '@example.com';
    $this->assertTrue(_multiple_email_access('pages', $this->owner), 'Owner passes access check.');
    multiple_email_register_email($uid, $email, FALSE);
    $this->assertTrue(multiple_email_find_address($email), 'Owner address stored via API.');

    // Admin access check on another account + API add.
    $user = $this->admin;
    $other_uid = $this->basic->uid;
    $other_email = $this->randomName() . '@example.com';
    $this->assertTrue(_multiple_email_access('pages', $this->basic), 'Admin passes access check on other account.');
    multiple_email_register_email($other_uid, $other_email, TRUE);
    $this->assertTrue(multiple_email_find_address($other_email), 'Admin address stored via API.');

    // Basic user should fail access check.
    $user = $this->basic;
    $this->assertFalse(_multiple_email_access('pages', $this->basic), 'Basic user denied access to email management.');
  }

}
